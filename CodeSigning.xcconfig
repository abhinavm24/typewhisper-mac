// TypeWhisper Code Signing Configuration
//
// To use your own signing identity, create CodeSigning.local.xcconfig:
//   echo 'DEVELOPMENT_TEAM = YOUR_TEAM_ID' > CodeSigning.local.xcconfig
//
// Find your Team ID: Xcode > Settings > Accounts > select team

// Personal fork updates are opt-in until an owned Sparkle public key is supplied.
// $() keeps xcconfig from treating the URL's double slash as a comment.
TYPEWHISPER_PERSONAL_UPDATE_FEED_URL = https:/$()/abhinavm24.github.io/typewhisper-mac/appcast.xml
TYPEWHISPER_PERSONAL_UPDATE_PUBLIC_KEY =
#include? "CodeSigning.local.xcconfig"
APP_GROUP_ID = $(DEVELOPMENT_TEAM).com.typewhisper.mac
TYPEWHISPER_RELEASE_CHANNEL = stable
TYPEWHISPER_RELEASE_TAG =
